{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "date",
    "source_files",
    "suites",
    "timeout_policies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "const": "SM-INSTR-GEN-TESTPLAN"
    },
    "version": {
      "const": "1.0"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source_files": {
      "type": "object",
      "required": [
        "vplan_testpoints",
        "vplan_features",
        "vplan_document",
        "sm_architecture"
      ],
      "properties": {
        "vplan_testpoints": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "vplan_features": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "vplan_document": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "sm_architecture": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "suites": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "case_ids",
          "repetitions",
          "seed_offset",
          "profile_override",
          "admission_gates",
          "stop_conditions",
          "status",
          "execution"
        ],
        "properties": {
          "id": {
            "enum": [
              "SMOKE",
              "DIRECTED",
              "NEGATIVE",
              "RANDOM",
              "STRESS",
              "REPLAY"
            ]
          },
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^TC-[A-Z0-9_-]+-[0-9]{3}$"
            }
          },
          "repetitions": {
            "type": "integer",
            "minimum": 1
          },
          "seed_offset": {
            "type": "integer",
            "minimum": 0
          },
          "profile_override": {
            "const": null
          },
          "admission_gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "const": "PLANNED"
          },
          "execution": {
            "const": "NOT_RUN"
          },
          "workload_policy": {
            "type": "object"
          }
        }
      }
    },
    "timeout_policies": {
      "type": "object",
      "required": [
        "GEN_BOUNDED",
        "REFERENCE_BOUNDED",
        "SM_PROGRESS",
        "SOC_PROGRESS"
      ],
      "properties": {
        "GEN_BOUNDED": {
          "type": "object",
          "minProperties": 1
        },
        "REFERENCE_BOUNDED": {
          "type": "object",
          "minProperties": 1
        },
        "SM_PROGRESS": {
          "type": "object",
          "minProperties": 1
        },
        "SOC_PROGRESS": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": false
    }
  }
}
